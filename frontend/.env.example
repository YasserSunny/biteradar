# BiteRadar Frontend Environment Variables

# Backend address reachable by the Next.js server. Browsers use same-origin /api.
API_BACKEND_URL=http://127.0.0.1:8000
# Production (set before building; restart/rebuild after changing):
# API_BACKEND_URL=https://biteradar-backend-xyz.a.run.app
# NEXT_PUBLIC_API_BASE_URL is still accepted as a legacy server-side fallback.
# Optional LAN hostname/IP for Next.js development assets (no scheme or port):
# DEV_ALLOWED_ORIGINS=192.168.1.100

# Firebase Authentication Client Configuration
# (Can be found in your Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
