# BiteRadar Backend Environment Variables

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
YELP_API_KEY=your_yelp_api_key_here
# Optional Phase 4 API Keys:
FOURSQUARE_API_KEY=your_foursquare_api_key_here
DOCUMENU_API_KEY=your_documenu_api_key_here

# Database URL
# Local Development: leave unset or use SQLite:
# DATABASE_URL=sqlite:///./biteradar.db
# Cloud / Production (e.g. Neon PostgreSQL, Supabase, Cloud SQL):
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration
# Comma-separated list of allowed origins (e.g., your Vercel or custom domain)
# ALLOWED_ORIGINS=https://biteradar.vercel.app,http://localhost:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Resilient search jobs: local by default; Cloud Run defaults to cloud_tasks.
# Production requires shared PostgreSQL DATABASE_URL and a configured queue.
# SEARCH_JOB_EXECUTOR=cloud_tasks
# SEARCH_TASK_QUEUE=projects/PROJECT/locations/REGION/queues/biteradar-searches
# SEARCH_WORKER_URL=https://YOUR-BACKEND.run.app
# SEARCH_TASK_SERVICE_ACCOUNT=worker@PROJECT.iam.gserviceaccount.com
